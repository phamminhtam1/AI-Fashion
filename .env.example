# For Local Development (Single machine):
#   -> Refer to .env.dev.example
#   -> cp .env.dev.example .env.dev
#
# For VM1 App Server (192.168.56.10):
#   -> Refer to .env.prod.example
#   -> cp .env.prod.example .env.prod
#
# For VM2 DB Server (192.168.56.20):
#   -> Refer to .env.db.example
#   -> cp .env.db.example .env.db
# ==========================================================

DATABASE_URL=postgres://elane:elane@localhost:5432/elane
SESSION_SECRET=dev-change-me-elane-phase1-secret
API_PORT=3001
API_HOST=0.0.0.0
UPLOAD_DIR=./uploads
STOREFRONT_ORIGIN=http://localhost:8090
ADMIN_ORIGIN=http://localhost:8081
COOKIE_SECURE=false
VITE_API_URL=http://localhost:3001

# Supabase Storage (product images) — server only
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-secret-or-service-role-key
