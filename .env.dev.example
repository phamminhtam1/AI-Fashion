# ==========================================================
# DEVELOPMENT ENVIRONMENT CONFIGURATION (.env.dev)
# Usage: cp .env.dev.example .env.dev
# docker compose --env-file .env.dev -f docker-compose.yml -f docker-compose.dev.yml up --build -d
# ==========================================================

# Database (PostgreSQL running inside dev Docker Compose)
POSTGRES_USER=elane
POSTGRES_PASSWORD=elane
POSTGRES_DB=elane
DATABASE_URL=postgres://elane:elane@postgres:5432/elane

# Backend / API
API_PORT=3001
API_HOST=0.0.0.0
SESSION_SECRET=dev-change-me-elane-phase1-secret
UPLOAD_DIR=/app/uploads

# Origins & URLs (Localhost development)
STOREFRONT_ORIGIN=http://localhost:8090
ADMIN_ORIGIN=http://localhost:8081
VITE_API_URL=http://localhost:3001
COOKIE_SECURE=false

# Supabase Storage (Optional - product images)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_MEDIA_BUCKET=products

# SePay bank transfer (Optional - payment webhooks)
SEPAY_WEBHOOK_SECRET=
SEPAY_BANK_ACCOUNT=
SEPAY_ACCOUNT_NAME=
SEPAY_BANK_NAME=
SEPAY_BANK_BIN=

# Ngrok token (Optional - webhook tunneling)
NGROK_AUTHTOKEN=

# Redis Queue & AI Virtual Try-On
REDIS_URL=redis://redis:6379
AI_WORKER_URL=http://ai-worker:8000
AI_TRYON_MAX_DAILY=5
AI_INPUT_RETENTION_HOURS=72
AI_RESULT_RETENTION_DAYS=30

# Python AI Worker Configuration
AI_MOCK_MODE=true
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.tuongtacgpt.click/v1
OPENAI_VISION_MODEL=gp-5.6-sol-max
KREA_EMAIL=
KREA_PASSWORD=
KREA_HEADLESS=true

# Kie.ai (GPT Image 2.5 Sunburst) Virtual Try-On
KIE_API_KEY=
KIE_BASE_URL=https://api.kie.ai
KIE_MODEL=gpt-image-2-5-sunburst-image-to-image
TRYON_PROVIDER=kie

