# AI Worker Configuration
APP_NAME=ÉLANE AI Worker
APP_ENV=development
PORT=8000
HOST=0.0.0.0

# Mock Mode
AI_MOCK_MODE=false

# Supabase Storage (AI Bucket)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_AI_BUCKET=AI

# OpenAI Compatible Vision Classifier
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.tuongtacgpt.click/v1
OPENAI_VISION_MODEL=gp-5.6-sol-max

# Kie.ai (GPT Image 2.5 Sunburst) Virtual Try-On
KIE_API_KEY=
KIE_BASE_URL=https://api.kie.ai
KIE_MODEL=gpt-image-2-5-sunburst-image-to-image
KIE_POLLING_INTERVAL_SECONDS=3.0
KIE_TIMEOUT_SECONDS=0
TRYON_PROVIDER=kie
