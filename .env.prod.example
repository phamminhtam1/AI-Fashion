# ==========================================================
# PRODUCTION CLOUD LAB CONFIGURATION (.env.prod)
# VM1 - App Server: 192.168.56.10
# VM2 - DB Server:  192.168.56.20
# Usage: cp .env.prod.example .env.prod
# docker compose --env-file .env.prod -f docker-compose.yml -f docker-compose.prod.yml up --build -d
# ==========================================================

# Database connection pointing to VM2 (192.168.56.20:5432)
# NOTE: Replace with matching credentials configured on VM2 (.env.db)
POSTGRES_USER=elane_prod_user
POSTGRES_PASSWORD=CHANGE_ME_SECURE_PASSWORD_FOR_PRODUCTION
POSTGRES_DB=elane_db
DATABASE_URL=postgres://elane_prod_user:CHANGE_ME_SECURE_PASSWORD_FOR_PRODUCTION@192.168.56.20:5432/elane_db

# Backend / API Settings
API_PORT=3001
API_HOST=0.0.0.0
SESSION_SECRET=GENERATE_A_LONG_RANDOM_SECRET_KEY_FOR_JWT_SESSION
UPLOAD_DIR=/app/uploads

# Network & Host IPs
APP_SERVER_IP=192.168.56.10
DB_SERVER_IP=192.168.56.20
MONITORING_SERVER_IP=192.168.56.30

# CORS & Client Origins
STOREFRONT_ORIGIN=http://192.168.56.10
ADMIN_ORIGIN=http://192.168.56.10:8081
CORS_ORIGINS=http://192.168.56.10,http://192.168.56.10:8081,http://192.168.56.10:8090,http://192.168.56.10:3001
COOKIE_SECURE=false

# Frontend API URL
# Leave blank to use relative reverse proxy path (/api) via Nginx
# Or set to http://192.168.56.10:3001 if calling backend directly
VITE_API_URL=

# Supabase Storage (Optional - product images, server only)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_MEDIA_BUCKET=products

# SePay bank transfer (Optional - payment webhooks)
SEPAY_WEBHOOK_SECRET=
SEPAY_BANK_ACCOUNT=
SEPAY_ACCOUNT_NAME=
SEPAY_BANK_NAME=
SEPAY_BANK_BIN=
